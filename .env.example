# Telegram
BOT_TOKEN=123456:replace-me
# Public HTTPS URL that proxies to 127.0.0.1:8000 (Mini Apps require HTTPS)
WEBAPP_URL=https://finance.example.com
# First owner; everyone else is added in the app (Settings -> Users)
OWNER_TELEGRAM_ID=0

# Database. SIGNER_DB_PASSWORD is for the read-only role the signer uses.
DB_PASSWORD=change-me
SIGNER_DB_PASSWORD=change-me-too

# Chain: nile (testnet, default) | mainnet
TRON_NETWORK=nile
TRONGRID_API_KEY=
CONFIRMATIONS=19

# Signer hard caps (USDT per transfer / per 24h), independent of the policy edited in the app
SIGNER_MAX_TX=1000
SIGNER_MAX_DAILY=3000

# The hot-wallet private key NEVER goes here: put it in ./secrets/signer_key (see README)
